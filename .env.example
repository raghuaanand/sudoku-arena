# ============================================
# SUDOKU ARENA - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# Core Configuration
# ============================================
NODE_ENV=development
PORT=3000
SOCKET_PORT=3003

# ============================================
# Database (PostgreSQL)
# ============================================
# Local development
DATABASE_URL="postgresql://username:password@localhost:5432/suduko"

# For Vercel with Supabase or Neon (connection pooler)
# DATABASE_URL="postgresql://user:pass@host:6543/db?pgbouncer=true"
# Direct connection for migrations
# DIRECT_URL="postgresql://user:pass@host:5432/db"

# ============================================
# NextAuth.js Authentication
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Local development
NEXTAUTH_URL=http://localhost:3000

# Production - set automatically by Vercel, or set manually:
# NEXTAUTH_URL=https://your-domain.vercel.app

# ============================================
# OAuth Providers (Optional)
# ============================================
# Supabase (if using Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth - https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# Razorpay Payment Gateway
# ============================================
# Get from https://dashboard.razorpay.com/app/keys

# Test mode keys (for development) - start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Live mode keys (for production) - start with rzp_live_
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-live-razorpay-secret

# Public key for frontend checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Webhook secret - set in Razorpay Dashboard > Webhooks
# Events to enable: payment.authorized, payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# Redis (Optional - for production)
# ============================================
# Falls back to in-memory storage if not set
# Required for: matchmaking queue persistence, game state sync across instances
# REDIS_URL=redis://default:password@host:6379

# ============================================
# Cron Job Security (Required for Vercel)
# ============================================
# Secret for authenticating scheduled maintenance jobs
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ============================================
# Socket.IO Configuration
# ============================================
# Local development - uses standalone socket server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003

# Production - set to your Render WebSocket server URL:
# NEXT_PUBLIC_SOCKET_URL=https://sudoku-arena-socket.onrender.com

# Note: Vercel doesn't support WebSocket, so socket server runs on Render (free tier)

